*.log
.DS_Store
.env
.env.backup
# Laravel loads .env.<APP_ENV> ahead of .env, so a committed .env.production
# silently overrides the server's real one. The template is .env.production.example.
.env.production
.env.production.*
!.env.production.example
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/hot
/public/storage
/storage/*.key
/storage/installed
/storage/pail
/vendor
composer.phar
Homestead.json
Homestead.yaml
Thumbs.db
ngrok.exe
ngrok-stdout.txt
ngrok-stderr.txt
Forever-love-deploy.zip
public.zip
*.zip

# Database backups - never commit these
storage/backups/

# Agent tooling — local to whoever is working here, not part of the application.
/.claude/
/.codex/
/.agents/
/skills-lock.json

# Reference photography the Dignified template was matched against. The template ships
# its own optimised webp under public/images/themes/; these are the originals and are
# large enough to be worth keeping out of the history.
/themes/*.png

# graphify code graph - regenerable in seconds, do not commit (added 2026-08-29)
graphify-out/
